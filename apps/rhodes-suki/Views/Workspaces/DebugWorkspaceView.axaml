<UserControl
    x:Class="RhodesSuki.Views.Workspaces.DebugWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding DebugLayout.Header.Title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DebugLayout.Header.Detail}" FontSize="12" Opacity="0.62" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="surfaceCard" Padding="10">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="6">
            <TextBlock Text="バグ報告ZIP" FontSize="14" FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="作成"
                    Command="{Binding CreateBugReportBundleCommand}"
                    Padding="12,5" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding BugReportBundleStatus}"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.68" />
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding LastBugReportBundlePath}"
                       FontFamily="Consolas"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Opacity="0.48" />
          </Grid>
        </Border>

        <Border Classes="surfaceCard" Padding="10">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <StackPanel Spacing="2">
              <TextBlock Text="受信報告の取込" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="ZIPまたは展開済みフォルダからFrame Recordsを読み込みます。" FontSize="11" TextWrapping="Wrap" Opacity="0.62" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="ZIP取込"
                    Click="ImportBugReportZipClick"
                    Padding="10,4"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Content="フォルダ"
                    Click="ImportBugReportFolderClick"
                    Padding="10,4"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="3"
                       Text="{Binding BugReportImportStatus}"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.68" />
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Text="{Binding BugReportImportPath}"
                       FontFamily="Consolas"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Opacity="0.48" />
          </Grid>
        </Border>

        <Border Classes="surfaceCard" Padding="10">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Text="最新の証跡" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding LastCapturePath}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Opacity="0.56" />
            <TextBlock Grid.Row="2" Text="{Binding LastResourceTaskResultsPath}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Opacity="0.56" />
          </Grid>
        </Border>

        <Expander Header="MAA開発ツール・証跡 (ローカルのみ)">
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <TextBlock Text="MSE/MPEはVS Codeのローカルプロジェクトを開きます。MLA/MEKも指定した端末内の素材だけを扱い、自動アップロードしません。"
                       FontSize="11" TextWrapping="Wrap" Opacity="0.64" />
            <TextBlock Text="MPE用pipelineは生成結果の確認用です。正規編集元は data/recognition/*.json で、生成JSONへ直接保存した変更は再生成時に上書きされます。"
                       FontSize="11" TextWrapping="Wrap" Opacity="0.64" />
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
              <Button Content="MSEで開く" Command="{Binding MaaDevelopmentTools.OpenMseCommand}" Padding="10,4" />
              <Button Grid.Column="1" Content="MPEで生成結果" Command="{Binding MaaDevelopmentTools.OpenMpeCommand}" Padding="10,4" />
              <Button Grid.Column="2" Content="MEK確認" Command="{Binding MaaDevelopmentTools.ProbeEvidenceKitCommand}" Padding="10,4" />
              <TextBlock Grid.Column="3" Text="{Binding MaaDevelopmentTools.RepositoryRoot}" FontFamily="Consolas" FontSize="10"
                         TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.48" />
            </Grid>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
              <StackPanel Spacing="2">
                <TextBlock Text="解析素材（maa.log / maafw.log / ZIP / フォルダ）" FontSize="11" Opacity="0.62" />
                <TextBox Text="{Binding MaaDevelopmentTools.MaterialsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <Button Grid.Column="1" Content="ファイル" Click="SelectMaaMaterialsFileClick" Padding="9,4" VerticalAlignment="Bottom" />
              <Button Grid.Column="2" Content="フォルダ" Click="SelectMaaMaterialsFolderClick" Padding="9,4" VerticalAlignment="Bottom" />

              <StackPanel Grid.Row="1" Spacing="2">
                <TextBlock Text="MaaLogAnalyzerローカル実行ファイル（任意）" FontSize="11" Opacity="0.62" />
                <TextBox Text="{Binding MaaDevelopmentTools.LogAnalyzerPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="例: C:\Tools\MaaLogAnalyzer.exe" />
              </StackPanel>
              <Button Grid.Row="1" Grid.Column="1" Content="参照" Click="SelectMaaLogAnalyzerClick" Padding="9,4" VerticalAlignment="Bottom" />
              <Button Grid.Row="1" Grid.Column="2" Content="MLA起動" Command="{Binding MaaDevelopmentTools.OpenLogAnalyzerCommand}" Padding="9,4" VerticalAlignment="Bottom" />
            </Grid>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="4">
              <StackPanel Spacing="2">
                <TextBlock Text="MaaEvidenceKitコマンド" FontSize="11" Opacity="0.62" />
                <TextBox Text="{Binding MaaDevelopmentTools.EvidenceExecutable, Mode=TwoWay}" PlaceholderText="maa-evidence" />
              </StackPanel>
              <Button Grid.Column="1" Content="証跡を生成" Command="{Binding MaaDevelopmentTools.RunEvidenceKitCommand}" Padding="12,4" VerticalAlignment="Bottom" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MaaDevelopmentTools.EvidenceSummary}" FontFamily="Consolas" FontSize="11"
                         TextWrapping="Wrap" Opacity="0.68" />
            </Grid>
            <TextBlock Text="{Binding MaaDevelopmentTools.Status}" FontSize="11" TextWrapping="Wrap" Opacity="0.72" />
            <TextBlock Text="{Binding MaaDevelopmentTools.LastEvidencePath}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Opacity="0.48" />
          </StackPanel>
        </Expander>

        <Expander Header="認識ラボ (MFAToolsPlus系の比較導線 / 状態へ未反映)">
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <Border CornerRadius="7" Padding="8" Background="{StaticResource WorkbenchSuccessSurface}" BorderBrush="{StaticResource WorkbenchSuccess}" BorderThickness="1">
              <TextBlock Text="ここではOCR・画像・色・歳の銭認識だけを実行します。タップ、スワイプ、キー入力、ラン状態への自動反映は行いません。"
                         FontSize="11" TextWrapping="Wrap" />
            </Border>

            <Grid ColumnDefinitions="260,*" ColumnSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="認識方式" FontSize="11" Opacity="0.62" />
                <ComboBox ItemsSource="{Binding RecognitionLab.ModeOptions}"
                          SelectedItem="{Binding RecognitionLab.SelectedMode, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding RecognitionLab.SelectedModeDetail}" FontSize="11"
                         TextWrapping="Wrap" VerticalAlignment="Bottom" Opacity="0.62" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Frame画像" FontSize="11" Opacity="0.62" />
                <TextBox Text="{Binding RecognitionLab.ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <Button Grid.Column="1" Content="画像を選択" Click="SelectRecognitionLabImageClick" Padding="9,4" VerticalAlignment="Bottom" />
              <Button Grid.Column="2" Content="最新Frame" Command="{Binding RecognitionLab.UseLatestCaptureCommand}" Padding="9,4" VerticalAlignment="Bottom" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
              <StackPanel Spacing="2"><TextBlock Text="ROI X" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="1279" Increment="1" FormatString="0" Value="{Binding RecognitionLab.RoiX, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="ROI Y" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="719" Increment="1" FormatString="0" Value="{Binding RecognitionLab.RoiY, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="幅" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="1" Maximum="1280" Increment="1" FormatString="0" Value="{Binding RecognitionLab.RoiWidth, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="2"><TextBlock Text="高さ" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="1" Maximum="720" Increment="1" FormatString="0" Value="{Binding RecognitionLab.RoiHeight, Mode=TwoWay}" /></StackPanel>
            </Grid>

            <Grid IsVisible="{Binding RecognitionLab.IsOcrMode}" ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2"><TextBlock Text="expected（カンマまたは改行区切り）" FontSize="10" Opacity="0.58" /><TextBox Text="{Binding RecognitionLab.Expected, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="threshold" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" Value="{Binding RecognitionLab.Threshold, Mode=TwoWay}" /></StackPanel>
              <CheckBox Grid.Column="2" Content="only_rec" IsChecked="{Binding RecognitionLab.OnlyRecognition, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
            </Grid>

            <Grid IsVisible="{Binding RecognitionLab.IsTemplateMode}" ColumnDefinitions="*,120,150" ColumnSpacing="8">
              <StackPanel Spacing="2"><TextBlock Text="template（resource/base/imageからの相対パス）" FontSize="10" Opacity="0.58" /><TextBox Text="{Binding RecognitionLab.Template, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="method" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="10" Increment="1" FormatString="0" Value="{Binding RecognitionLab.TemplateMethod, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="threshold" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" Value="{Binding RecognitionLab.Threshold, Mode=TwoWay}" /></StackPanel>
            </Grid>

            <Grid IsVisible="{Binding RecognitionLab.IsColorMode}" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,120,120" ColumnSpacing="8" RowSpacing="6">
              <StackPanel Spacing="2"><TextBlock Text="lower (3値)" FontSize="10" Opacity="0.58" /><TextBox Text="{Binding RecognitionLab.ColorLower, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="upper (3値)" FontSize="10" Opacity="0.58" /><TextBox Text="{Binding RecognitionLab.ColorUpper, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="method" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="0" Maximum="255" Increment="1" FormatString="0" Value="{Binding RecognitionLab.ColorMethod, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="2"><TextBlock Text="count" FontSize="10" Opacity="0.58" /><NumericUpDown Minimum="1" Maximum="921600" Increment="1" FormatString="0" Value="{Binding RecognitionLab.ColorCount, Mode=TwoWay}" /></StackPanel>
              <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="connected（連結領域として判定）" IsChecked="{Binding RecognitionLab.ColorConnected, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Content="認識だけ実行" Command="{Binding RecognitionLab.RunCommand}" Padding="14,5" />
              <TextBlock Grid.Column="1" Text="{Binding RecognitionLab.Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.72" />
            </Grid>
            <TextBox Text="{Binding RecognitionLab.ResultJson}" IsReadOnly="True" AcceptsReturn="True" MinHeight="150" MaxHeight="300"
                     FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="認識結果JSON" />
            <TextBlock Text="{Binding RecognitionLab.LastLogPath}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Opacity="0.48" />
          </StackPanel>
        </Expander>

        <Border Classes="surfaceCard" Padding="10">
          <Grid RowDefinitions="Auto,180" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2">
                <TextBlock Text="Frame Records" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="ADBなし再検証用の保存スクリーンショットです。" FontSize="11" TextWrapping="Wrap" Opacity="0.62" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding FrameRecordHistory.Count}" FontFamily="Consolas" FontSize="12" Opacity="0.62" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="更新" Command="{Binding RefreshFrameRecordHistoryCommand}" Padding="10,4" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1">
              <StackPanel IsVisible="{Binding IsFrameRecordHistoryEmpty}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="6">
                <TextBlock Text="保存済みFrameはありません" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.72" />
                <TextBlock Text="接続・撮影または認識を実行すると、ADBなしで再検証できるFrameがここに保存されます。"
                           FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.5" />
              </StackPanel>
              <ScrollViewer IsVisible="{Binding HasFrameRecordHistory}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FrameRecordHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="7" Padding="8" Margin="0,0,0,6" Background="{StaticResource WorkbenchSubtleSurface}" BorderBrush="{StaticResource WorkbenchSeparator}" BorderThickness="1">
                      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding CapturedAtLabel}" FontFamily="Consolas" FontSize="11" Opacity="0.72" />
                          <TextBlock Text="{Binding ProfileLabel}" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Source}" FontFamily="Consolas" FontSize="11" Opacity="0.55" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Grid.RowSpan="3"
                                Content="読込"
                                Command="{Binding DataContext.LoadFrameRecordHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,3"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Grid.RowSpan="3"
                                Content="再認識"
                                Command="{Binding DataContext.ReplayFrameRecordRecognitionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,3"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{Binding Detail}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.62" />
                        <TextBlock Grid.Row="2" Text="{Binding ImagePath}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Opacity="0.46" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <Expander Header="インスペクタ (開発者向け)">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="現在の接続・認識・出力状態のスナップショットです。報告調査時の突き合わせに使います。" FontSize="11" Opacity="0.62" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding InspectorRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="7" Padding="9" Margin="0,0,0,6" Background="{StaticResource WorkbenchFloating}" BorderBrush="{StaticResource WorkbenchSeparator}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="110,*" ColumnSpacing="8">
                      <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.58" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Opacity="0.52" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander Header="操作カタログ (開発者向け)">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="現在のワークスペースで実行できる操作の一覧です。" FontSize="11" Opacity="0.62" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding WorkspaceActionCountLabel}" FontFamily="Consolas" FontSize="11" Opacity="0.58" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding WorkspaceActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="7" Padding="9" Margin="0,0,0,8" Background="{StaticResource WorkbenchSubtleSurface}" BorderBrush="{StaticResource WorkbenchSeparator}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding SectionId}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Opacity="0.54" />
                        <Button Grid.Column="2"
                                Content="{Binding ActionButtonLabel}"
                                Command="{Binding Command}"
                                CommandParameter="{Binding CommandParameter}"
                                IsEnabled="{Binding IsExecutable}"
                                Padding="8,3" />
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Workflow}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.64" />
                      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                        <Border CornerRadius="5" Padding="6,2" Background="{StaticResource WorkbenchSuccessSurface}" BorderBrush="{StaticResource WorkbenchSuccess}" BorderThickness="1">
                          <TextBlock Text="{Binding MaaRequirementLabel}" FontSize="11" />
                        </Border>
                        <Border Grid.Column="1" CornerRadius="5" Padding="6,2" Background="{StaticResource WorkbenchWarningSurface}" BorderBrush="{StaticResource WorkbenchWarning}" BorderThickness="1">
                          <TextBlock Text="{Binding StateWriteLabel}" FontSize="11" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Opacity="0.52" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander Header="認識Probe (開発者向け)">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding ProbePayloads}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="7" Padding="9" Background="{StaticResource WorkbenchFloating}" BorderBrush="{StaticResource WorkbenchSeparator}" BorderThickness="1" Margin="0,0,0,8">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="4">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Grid.RowSpan="3" Content="実行" Command="{Binding DataContext.RunProbeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Text="{Binding Purpose}" FontSize="11" TextWrapping="Wrap" Opacity="0.66" />
                      <TextBlock Grid.Row="2" Text="{Binding Payload}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.58" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ProbeResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="7" Padding="9" Background="{StaticResource WorkbenchFloating}" BorderBrush="{StaticResource WorkbenchSeparator}" BorderThickness="1" Margin="0,0,0,8">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Status}" FontFamily="Consolas" FontSize="12" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.72" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <ItemsControl ItemsSource="{Binding DebugLogLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.68" Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding DebugMigrationSection.Title}" FontSize="14" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding MigrationSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Opacity="0.62" Margin="0,0,0,5" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
