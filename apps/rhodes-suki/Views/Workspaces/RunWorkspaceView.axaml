<UserControl
    x:Class="RhodesSuki.Views.Workspaces.RunWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RhodesSuki.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="ラン" Classes="displayTitle" />
          <TextBlock Text="配信中に必要な取得値、手動補正、ボス、現在の選択を管理します。" Classes="body" />
        </StackPanel>
        <Button Grid.Column="1" Classes="dangerAction" Content="ランをクリア"
                Command="{Binding ShowClearRunConfirmationCommand}" />
      </Grid>

      <Border Classes="resultBanner" IsVisible="{Binding IsClearRunConfirmationVisible}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Text="ラン値・特殊値・ボス・オペレーター・秘宝を初期化します。この操作は元に戻せません。"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="tertiaryAction" Content="キャンセル" Command="{Binding CancelClearRunCommand}" />
          <Button Grid.Column="2" Classes="dangerAction" Content="クリア実行" Command="{Binding ConfirmClearRunCommand}" />
        </Grid>
      </Border>

      <Border Classes="filterBar">
        <StackPanel Spacing="4">
          <WrapPanel Classes="runtimeActions" HorizontalAlignment="Left">
            <TextBlock Text="項目を指定して取得" Classes="denseLabel" VerticalAlignment="Center" Margin="4,0,16,8" />
            <Button Classes="secondaryAction compactAction" Content="基本情報"
                    Command="{Binding RunCommonRecognitionAndApplyCommand}" ToolTip.Tip="源石錐・等級・分隊を取得して反映します" />
            <Button Classes="secondaryAction compactAction" Content="特殊値"
                    Command="{Binding RunCurrentSpecialRecognitionAndApplyCommand}" ToolTip.Tip="現在テーマの特殊値を取得して反映します" />
            <Button Classes="secondaryAction compactAction" Content="オペレーター"
                    Command="{Binding RunProfileRecognitionAndApplyCommand}" CommandParameter="operatorsFull" />
            <Button Classes="secondaryAction compactAction" Content="秘宝"
                    Command="{Binding RunProfileRecognitionAndApplyCommand}" CommandParameter="relicsFull" />
            <Button Classes="tertiaryAction compactAction" Content="撮影のみ" Command="{Binding CaptureCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding LastCandidateApplySummary}" Classes="caption" TextWrapping="Wrap"
                     MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LastCandidateApplySummary}" Margin="4,0" />
        </StackPanel>
      </Border>

      <Border Classes="metricBand" Padding="0">
        <ItemsControl ItemsSource="{Binding HeaderStatusChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="{Binding RunHeaderColumnCount}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="18,14" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="0,0,1,0"
                      MinHeight="76">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                  <TextBlock Text="{Binding Value}" Classes="metricValue" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Grid ColumnDefinitions="2*,1.15*" ColumnSpacing="16">
        <Border Classes="surfaceCard">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="手動補正" Classes="sectionTitle" />
                <Border Classes="statusPill" Classes.unapplied="{Binding HasUnappliedManualRunValues}"
                        HorizontalAlignment="Left">
                  <TextBlock Text="{Binding ManualRunValuesStatusLabel}" Classes="caption" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="primaryAction" Content="{Binding ManualRunValuesButtonLabel}"
                        Command="{Binding ApplyManualRunValuesCommand}" ToolTip.Tip="入力値を現在のランへ反映します" />
                <Button Classes="tertiaryAction compactAction" Content="入力を戻す"
                        Command="{Binding RevertManualRunValuesCommand}" IsEnabled="{Binding HasUnappliedManualRunValues}"
                        ToolTip.Tip="未反映の手動補正だけを現在の値に戻します" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Classes="informationBanner" IsVisible="{Binding IsManualDifficultyCampaign}">
              <TextBlock Text="{Binding ManualDifficultyGuidance}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,1.45*" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="源石錐" Classes="eyebrow" />
                <controls:RhodesNumericUpDown Minimum="0" Maximum="9999" Increment="1" FormatString="0"
                               AutomationProperties.Name="源石錐" Value="{Binding ManualIngot, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="等級" Classes="eyebrow" />
                <controls:RhodesNumericUpDown Minimum="1" Maximum="{Binding ManualDifficultyMaximum}" Increment="1" FormatString="0"
                               AutomationProperties.Name="等級" Value="{Binding ManualDifficulty, Mode=TwoWay}" />
                <TextBlock Text="{Binding ManualDifficultyTierLabel}" Classes="caption" Foreground="{StaticResource WorkbenchSuccess}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="分隊" Classes="eyebrow" />
                <ComboBox AutomationProperties.Name="分隊" ItemsSource="{Binding ManualSquadOptions}" SelectedItem="{Binding SelectedManualSquad, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding IsManualSquadRandomEffectVisible}">
              <TextBlock Text="追加効果" Classes="eyebrow" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ManualSquadRandomEffectOptions}"
                        SelectedItem="{Binding SelectedManualSquadRandomEffect, Mode=TwoWay}" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="surfaceCard">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="現在の選択" Classes="sectionTitle" />
              <TextBlock Text="{Binding RunSelectionSummary}" Classes="body" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding RunSelectionHighlights}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="56" Height="56" Margin="0,0,8,8" CornerRadius="7" ClipToBounds="True"
                          Background="{StaticResource WorkbenchSurfaceRaised}" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="1"
                          ToolTip.Tip="{Binding Name}">
                    <Image Source="{Binding ImagePath, Converter={StaticResource BitmapPathConverter}}" Stretch="UniformToFill" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Grid.Row="2" Classes="runtimeActions" HorizontalAlignment="Left">
              <Button Classes="secondaryAction compactAction" Content="オペレーターを編集"
                      Command="{Binding NavigateToOperatorsCommand}" />
              <Button Classes="secondaryAction compactAction" Content="秘宝を編集"
                      Command="{Binding NavigateToRelicsCommand}" />
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Classes="surfaceCard">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="大会メモ" Classes="sectionTitle" />
              <TextBlock Text="点数・引き出し数・メモをOBSへ反映します。" Classes="caption" TextWrapping="Wrap" />
              <Border Classes="statusPill" Classes.unapplied="{Binding HasUnappliedTournamentInfo}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding TournamentInfoStatusLabel}" Classes="caption" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="tertiaryAction compactAction" Content="入力を戻す"
                      Command="{Binding RevertTournamentInfoCommand}" IsEnabled="{Binding HasUnappliedTournamentInfo}"
                      ToolTip.Tip="未反映の大会メモだけを現在の値に戻します" />
              <Button Classes="primaryAction" Content="{Binding TournamentInfoButtonLabel}" Command="{Binding ApplyTournamentInfoCommand}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="180,180,*" ColumnSpacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="点数" Classes="eyebrow" />
              <controls:RhodesNumericUpDown Minimum="-999999" Maximum="999999" Increment="1" FormatString="0"
                             Value="{Binding ManualTournamentScore, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="引き出し数" Classes="eyebrow" />
              <controls:RhodesNumericUpDown Minimum="0" Maximum="9999" Increment="1" FormatString="0"
                             Value="{Binding ManualTournamentWithdrawals, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="配信用メモ" Classes="eyebrow" />
              <TextBox Text="{Binding ManualTournamentMemo, Mode=TwoWay}"
                       MaxLength="160" PlaceholderText="例: 決勝 第2試合 / 投資目標 300" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Classes="surfaceCard">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="ボス" Classes="sectionTitle" />
            <TextBlock Text="最大4体。選択はOBSへ即時反映します。" Classes="caption compactHelp"
                       ToolTip.Tip="最大4体を横並びで登録できます。選択内容はOBS出力へ即時反映されます。" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding BossSections}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="4" HorizontalAlignment="Stretch" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border MinWidth="0" Margin="0,0,10,0" Padding="10"
                        Background="{StaticResource WorkbenchSurfaceRaised}" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="1" CornerRadius="7">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                      <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True"
                              Background="{StaticResource WorkbenchCanvas}" BorderBrush="{StaticResource WorkbenchBorder}" BorderThickness="1">
                        <Image Source="{Binding SelectedOption.ImagePath, Converter={StaticResource BitmapPathConverter}}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Helper}" Classes="caption compactHelp"
                                   ToolTip.Tip="{Binding Helper}" />
                      </StackPanel>
                    </Grid>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                              IsVisible="{Binding IsSingleSelection}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Options}" IsVisible="{Binding AllowsMultiple}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="catalogItem" Classes.selected="{Binding IsSelected}"
                                  Content="{Binding DisplayName}"
                                  Command="{Binding DataContext.ToggleBossOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" Padding="8,5" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
